# Protezione cartella inc/data da accesso HTTP diretto e directory listing
Options -Indexes
<FilesMatch "(\.(php|csv|bak|tmp)|^ai_config\.json)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>


# Protezione cartella inc/data da accesso HTTP diretto e directory listing
Options -Indexes
<FilesMatch "(?i)(\.(php|csv|bak)$|\.tmp[0-9a-f.]*$|ai_config\.json)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>


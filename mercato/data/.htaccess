# Protezione cartella dati e report da accesso diretto via browser:
# qui dentro nulla va servito via HTTP, quindi si nega l'intera cartella (sottocartelle comprese)
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
